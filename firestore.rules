rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function self(uid) { return signedIn() && request.auth.uid == uid; }
    function admin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{uid} {
      allow read: if self(uid) || admin();
      allow write: if false;
    }

    match /players/{uid} {
      allow read: if self(uid) || admin();
      allow create: if self(uid)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.points == 0;
      allow update: if self(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.points == resource.data.points;
      allow delete: if self(uid);
    }

    match /matches/{id} {
      allow read: if signedIn() &&
        (request.auth.uid in resource.data.players || admin());
      allow create: if false;
      allow update: if signedIn() &&
        request.auth.uid in resource.data.players
        && request.resource.data.players == resource.data.players
        && request.resource.data.tournamentPoints == resource.data.tournamentPoints;
      allow delete: if false;
    }

    match /tournaments/{id} {
      allow read: if signedIn();
      allow create, update, delete: if admin();
    }

    match /settings/{id} {
      allow read: if signedIn();
      allow write: if admin();
    }

    match /transactions/{id} {
      allow read: if admin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow write: if false;
    }
  }
}
